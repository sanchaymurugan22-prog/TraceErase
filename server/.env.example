# ---- TraceErase server settings ----
# Copy this file to .env and fill in what you have. Only GEMINI_API_KEY is needed for AI.

PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
JWT_SECRET=replace-with-a-long-random-string

# Gemini. Get a free key at https://aistudio.google.com/apikey (starts with "AIza").
# Google Cloud / Vertex AI express keys (start with "AQ.") work too once the Gemini API is enabled for their project.
# "npm run check:ai" finds the models your key can use and fills in the three lines below.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite,gemini-flash-latest,gemini-2.5-flash
# auto | vertex | studio
GEMINI_PROVIDER=auto

# Online (Render): Firestore storage and Firebase sign-in. Leave empty on your computer.
# FIREBASE_SERVICE_ACCOUNT = the whole private key JSON (Firebase → Project settings → Service accounts)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
# Brevo (free email sending over HTTPS), only useful with your own domain
BREVO_API_KEY=
MAIL_FROM=
# Secrets for the email worker and the scheduled jobs (any long random text)
INBOUND_SECRET=
CRON_SECRET=
DEMO_MODE=true

# Protected identity
PROTECTED_EMAIL_DOMAIN=te.mail
PROTECTED_NUMBER_PREFIX=+91 70000

# Passkeys (keep localhost for local development)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Optional: real email sending (codes, deletion requests, forwarding). Without it, see the Dev outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TraceErase <no-reply@yourdomain.com>

# Only when true (and SMTP is set) are deletion requests emailed to real companies.
# Otherwise they wait in the Dev outbox for you to review, copy or send yourself.
SEND_REAL_REQUESTS=false

# Optional: real SMS codes through Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional: real Gmail scanning (Google Cloud OAuth client, scope gmail.metadata)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback

# Optional: publish ledger seals on a public blockchain (Polygon Amoy testnet).
# Only ANCHOR_PRIVATE_KEY is needed: run `node server/scripts/anchor-wallet.mjs` to make a test-only wallet,
# get free test POL from https://faucet.polygon.technology , then paste its key here (or in Render).
# Without ANCHOR_CONTRACT each seal is written into a transaction the wallet sends to itself.
ANCHOR_PRIVATE_KEY=
ANCHOR_RPC_URL=
ANCHOR_CONTRACT=
ANCHOR_NETWORK_NAME=Polygon Amoy

# Optional: Ed25519 key that signs every receipt (64 hex characters). If empty, it is derived from JWT_SECRET.
TRACE_SIGNING_SEED=

# How often receipts are bundled into a Merkle batch (seconds)
LEDGER_BATCH_SECONDS=60
DEMO_MODE=true

# Built-in regulator (Data Protection Board) logins, "email:password" pairs separated by commas.
# Change these before showing the app to anyone else.
REGULATOR_ACCOUNTS=regulator@traceerase.demo:Regulator@2026,board.officer@traceerase.demo:Board@2026
